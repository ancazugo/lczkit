# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.claude/
*.pdf

# Reference material — the PDFs are gitignored for licensing, not size, but the *directory*
# is not. `docs/references/README.md`, `references.bib` and everything in
# `docs/references/tables/` are committed: the transcribed tables are the authority for every
# numeric lookup in this package, so a checkout without them cannot reproduce a classification.
docs/references/**/*.pdf
docs/references/datasets/
!docs/references/tables/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Documentation build. `site/` is mkdocs' output directory and `.cache/` is what
# mkdocs-material's plugins write; the docs workflow caches the latter between runs.
site/
.cache/