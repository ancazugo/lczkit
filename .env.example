# Path to the shared data directory (input/ and output/lczkit/ live under it).
# See CLAUDE.md's "Environment and paths" section for the expected layout.
DATA_DIR=/path/to/shared/data/directory

# Google Cloud project Earth Engine bills against. Optional — only `EarthEngineSource`
# (Phase 4) needs it, and it says so plainly if it is missing. The local raster path,
# which is what CI tests, never touches Earth Engine.
GEE_PROJECT_NAME=your-earth-engine-project

# MapTiler Cloud key, for the `maptiler-hybrid` and `maptiler-topo` base maps. Optional —
# every other base map, and the whole pipeline, works without it.
#
# NOTE THIS TRAVELS WITH THE SITE. MapLibre fetches tiles from the browser, so a site built
# with a MapTiler base map carries this key in plain text in its style.json, and whoever
# receives the directory has it. It is deliberately kept out of the run manifest, which is
# not the same as keeping it private. Restrict the key by origin in the MapTiler console,
# or build the site with a keyless base map (osm, carto-positron, carto-dark,
# esri-satellite) when it is going to be handed on.
MAPTILER_API_KEY=your-maptiler-key
