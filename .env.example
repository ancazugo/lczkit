# Path to the shared data directory (input/ and output/lczkit/ live under it).
# See CLAUDE.md's "Environment and paths" section for the expected layout.
DATA_DIR=/path/to/shared/data/directory

# Google Cloud project Earth Engine bills against. Optional — only `EarthEngineSource`
# (Phase 4) needs it, and it says so plainly if it is missing. The local raster path,
# which is what CI tests, never touches Earth Engine.
GEE_PROJECT_NAME=your-earth-engine-project
